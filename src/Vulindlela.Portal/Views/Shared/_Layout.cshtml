<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Vulindlela</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-light bg-light mb-4 px-3">
        <a class="navbar-brand" href="/">Vulindlela</a>
        <div>
            <a href="/Bookings/Branches" class="btn btn-sm btn-primary">Book</a>
            <a href="/MyAppointments" class="btn btn-sm btn-outline-secondary">My Appointments</a>
            <a href="/AccessLog" class="btn btn-sm btn-outline-secondary">Access Log</a>
            @if (User.IsInRole("Official"))
            {
                <a href="/Official" class="btn btn-sm btn-success">View details</a>
            }
            <form method="post" action="/Account/SignOut" class="d-inline">
                <button class="btn btn-sm btn-outline-dark">Sign out</button>
            </form>
        </div>
    </nav>
    <div class="container">
        @if (ViewBag.Degraded is string d)
        {
            <div class="alert alert-warning">@d</div>
        }
        @RenderBody()
    </div>
</body>
</html>